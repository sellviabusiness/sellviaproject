# Which auth backend the frontend talks to. Defaults to "mock" if unset — the app must be fully
# usable with zero real Kratos environment available. Set to "kratos" once a real Ory Kratos
# project exists (see NEXT_PUBLIC_ORY_KRATOS_URL below).
NEXT_PUBLIC_AUTH_PROVIDER=mock

# Ory Kratos project URL (Docs/Infrastructure & DevOps/Environment Setup Guide calls this
# ORY_KRATOS_URL). Only read when NEXT_PUBLIC_AUTH_PROVIDER=kratos. On Ory Network this is your
# project's "SDK URL". The value below is a LOCAL PLACEHOLDER (a self-hosted Kratos's default
# dev port) — it is NOT a real endpoint and nothing points at it until you set one up. Do not
# treat this as production configuration.
NEXT_PUBLIC_ORY_KRATOS_URL=http://localhost:4433
